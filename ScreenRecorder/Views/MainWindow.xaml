<Window x:Class="ScreenRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScreenRecorder.ViewModels"
        Title="Screen Recorder"
        Height="600"
        Width="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Screen Recorder"
                       FontSize="32"
                       FontWeight="Light"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Configuration Panel -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Recording Controls -->
                    <TextBlock Text="Recording"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Screen Selection -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Screen to Record:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableScreens}"
                                  SelectedItem="{Binding SelectedScreen}"
                                  Background="{StaticResource PrimaryBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  Padding="12,8"
                                  FontSize="14"/>
                    </Grid>

                    <!-- Output Folder -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Output Folder:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Configuration.OutputFolder}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0"/>

                        <Button Grid.Column="2"
                                Content="Browse..."
                                Style="{StaticResource ModernButton}"
                                Command="{Binding SelectOutputFolderCommand}"
                                Padding="16,8"/>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,12,0,24"/>

                    <!-- Mouse Tracking Settings -->
                    <TextBlock Text="Mouse Tracking"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Enable Mouse Tracking -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Enable Auto-Tracking:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding Configuration.EnableMouseTracking}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextBrush}"/>
                    </Grid>

                    <!-- Zoom Level -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Zoom Level:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <Slider Grid.Column="1"
                                Minimum="1.0"
                                Maximum="3.0"
                                Value="{Binding Configuration.ZoomLevel}"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Configuration.ZoomLevel, StringFormat={}{0:F1}x}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,24"/>

                    <!-- Video Settings -->
                    <TextBlock Text="Video Settings"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Frame Rate -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Frame Rate:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding Configuration.FrameRate}"
                                  Background="{StaticResource PrimaryBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  Padding="12,8"
                                  FontSize="14">
                            <ComboBox.Items>
                                <ComboBoxItem Content="30 FPS" Tag="30"/>
                                <ComboBoxItem Content="60 FPS" Tag="60" IsSelected="True"/>
                                <ComboBoxItem Content="120 FPS" Tag="120"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    <!-- Video Quality -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Video Quality:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <Slider Grid.Column="1"
                                Minimum="50"
                                Maximum="100"
                                Value="{Binding Configuration.VideoQuality}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Configuration.VideoQuality}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Remove Browser Frame -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Remove Browser Frame:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding Configuration.RemoveBrowserFrame}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextBrush}"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Control Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Recording Duration -->
            <TextBlock Grid.Column="0"
                       Text="{Binding RecordingDuration, StringFormat={}{0:mm\\:ss}}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Start Recording"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding StartRecordingCommand}"
                        Padding="24,12"
                        FontSize="16"
                        Margin="0,0,12,0"/>

                <Button Content="Stop Recording"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding StopRecordingCommand}"
                        Padding="24,12"
                        FontSize="16"
                        Background="#8B0000"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
